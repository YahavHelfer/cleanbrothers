{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowExactCmsMediaObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::<DEDICATED_BUCKET>/cms-media/*"
    },
    {
      "Sid": "DenyAllBucketEnumeration",
      "Effect": "Deny",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:ListBucketMultipartUploads",
        "s3:ListAllMyBuckets"
      ],
      "Resource": "*"
    }
  ]
}
